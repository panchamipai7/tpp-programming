int motor = 9;
int limitSwitch = 2;
bool home = false;

void setup() {
  pinMode(motor, OUTPUT);
  pinMode(limitSwitch, INPUT_PULLUP);
  Serial.begin(9600);
}

void loop() {
  analogWrite(motor, 128);   // PWM

  if (digitalRead(limitSwitch) == LOW) {
    home = true;
    analogWrite(motor, 0);
    Serial.println("Homing complete");
    delay(500);
  }
}
